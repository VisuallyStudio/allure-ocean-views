# Contact form (api/contact.js). Set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sender@example.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Allure Ocean Views <sender@example.com>"
MAIL_TO=mail@makeitvisually.com
# "false" stops the confirmation email (with the brochure PDF) to the visitor
SEND_BROCHURE=true
